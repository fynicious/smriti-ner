# Database (SQLite for local dev; Neon/PostgreSQL URL for free cloud deployment)
DATABASE_URL="file:./dev.db"

# NextAuth.js (REQUIRED >= 32 chars — generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Field-Level & Media Encryption at Rest (REQUIRED >= 32 bytes hex/base64 — generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=""

# Private Media Storage Driver: LOCAL_PRIVATE | DB_ENCRYPTED | SUPABASE_PRIVATE
# Defaults automatically: DB_ENCRYPTED when DATABASE_URL is postgres*, else LOCAL_PRIVATE
MEDIA_STORAGE_DRIVER="LOCAL_PRIVATE"
MEDIA_STORAGE_DIR="./private_media"

# Optional Free Supabase Storage Private Bucket (1 GB free, zero credit card required)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="smriti-private-media"

# Clinician Registration Gate (Required when registering clinicians)
CLINICIAN_INVITE_CODE=""

# Free AI Companion Services (Server-only; never expose NEXT_PUBLIC_)
# Leave unset or set SMRITI_AI_PROVIDER=local for offline/zero-cost deterministic assistant
SMRITI_AI_PROVIDER="groq"
GROQ_API_KEY=""
# Gemini free tier trains on inputs unless billing enabled; set GEMINI_PAID_OR_PRIVATE=true only on private/paid billing
# GEMINI_API_KEY=""
# GEMINI_PAID_OR_PRIVATE="false"

# Optional Emergency SMS (SOS stays honest AUDIT_LOGGED_ONLY when unset)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# CAREGIVER_PHONE_NUMBER=""

# Optional Free Web Push VAPID Keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT=""
